# Round-1 Xiaomi Redmi K60 Ultra (corot, MT6985) fragment
# Merge on top of arch/arm64/configs/defconfig:
#   scripts/kconfig/merge_config.sh arch/arm64/configs/defconfig \
#       arch/arm64/configs/corot.config

CONFIG_ARCH_MEDIATEK=y
CONFIG_MTK_SCPSYS_MT6985=y
CONFIG_MAILBOX=y
CONFIG_MTK_MBOX=y
CONFIG_RPMSG_MTK_MBOX=y
CONFIG_MTK_IPI=y
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_CMDQ_MBOX_EXT=y
CONFIG_MTK_MMINFRA=y
CONFIG_MTK_IOMMU=y
CONFIG_MTK_IOMMU_MT6985=y
CONFIG_MTK_MML=y
CONFIG_DRM_PANEL_M12_MIN=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM=y
CONFIG_PINCTRL_MT6985=y
CONFIG_COMMON_CLK_MT6985=y
CONFIG_SERIAL_8250_MT6577=y

# Early display from LK leftover buffer
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# Single-core first boot is a cmdline maxcpus=1, SMP stays compiled
CONFIG_SMP=y
CONFIG_NR_CPUS=8

# pstore / ramoops at 0x48090000
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# printk mirror into live-DT log_store 0x7ffbf000
CONFIG_COROT_MARKER_WRITER=y
# CONFIG_COROT_FB_SCAN is not set
CONFIG_COROT_SKIP_SMCCC_TRNG_SOC_ID=y

# allow /dev/mem probe of nomap reserved framebuffer
# CONFIG_STRICT_DEVMEM is not set

# initramfs / rootfs later
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Keep MediaTek UFS/USB options compile-ready, probe later
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_GADGET=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_GADGET=y

# Do not enable MT6895-only display/GPU/touch fragments
# CONFIG_DRM_PANEL_L16_36_02_0B_DSC_VDO is not set
# CONFIG_TOUCHSCREEN_NVT_TS_SPI is not set
# CONFIG_XAGA_MARKER_WRITER is not set
# CONFIG_DRM_PANTHOR is not set

CONFIG_REGULATOR_FIXED_VOLTAGE=y

CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y

CONFIG_PHY_MTK_XSPHY=y
CONFIG_USB_G_SERIAL=y
CONFIG_USB_LIBCOMPOSITE=y
