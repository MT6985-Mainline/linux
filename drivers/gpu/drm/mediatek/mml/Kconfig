config MTK_MML
	tristate "DRM MML Support for Mediatek SoCs"
	help
	  Choose this option if you have a Mediatek SoCs.
	  The module will be called mml in mediatek-drm
	  This driver provides kernel mode setting and
	  buffer management to display driver.

config MTK_MML_DEBUG
	bool "DRM MML Debug Support for Mediatek SoCs"
	help
	  Choose this option if you have a Mediatek SoCs.
	  This driver provides mml driver unit test nodes
	  and mml driver debug feature. Trigger by mml
	  UnitTest binary.

config MTK_MML_LEGACY
	tristate "DRM MML Legacy Support for Mediatek SoCs"
	help
	  Choose this option if you have a Mediatek SoCs.
	  The module will be called mml in mediatek-drm
	  This driver provides kernel mode setting and
	  buffer management to display driver.


config MTK_MML_MT6985
	tristate "MediaTek MT6985 MML topology"
	depends on MTK_MML
	default MTK_MML if COMMON_CLK_MT6985
	help
	  Build the complete MT6985 MML path, client and mode-selection tables.
	  This is required by the corot display pipeline.

config MTK_MML_MT6886
	tristate "MediaTek MT6886 MML topology"
	depends on MTK_MML
	help
	  Build the MT6886-specific MML path tables.

config MTK_MML_MT6983
	tristate "MediaTek MT6983 MML topology"
	depends on MTK_MML
	help
	  Build the legacy MT6983-specific MML path tables.
